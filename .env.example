# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Transaction pooler (port 6543) — used by the running app at runtime.
# Must include ?pgbouncer=true (Supabase includes this by default when copied from the dashboard).
DATABASE_URL=

# Supabase Session pooler (port 5432, IPv4-compatible) — used only for `prisma migrate`.
DIRECT_URL=

PORT=3000

# JWT signing secret for front-desk auth. Must be >=32 characters — the server
# refuses to start otherwise. Generate a real random value for .env, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Channex.io API credentials (staging: https://staging.channex.io, no card required).
# user-api-key header value, generated from the Organization page in Channex's dashboard.
CHANNEX_API_KEY=

CHANNEX_BASE_URL=

# Channex has no built-in webhook signing (per Phase 4 research) — this is a
# shared secret WE invent, set as a custom header on the webhook's Channex-side
# config, and check for on every incoming request.
CHANNEX_WEBHOOK_SECRET=
