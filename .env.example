# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Transaction pooler (port 6543) — used by the running app at runtime.
# Must include ?pgbouncer=true (Supabase includes this by default when copied from the dashboard).
# Staging and production are separate Supabase projects under separate accounts —
# staging = johnbernardtabanao@gmail.com, production = hirayasystems@gmail.com.
# Local dev / this file's real .env always points at staging, never production.
DATABASE_URL=

# Supabase Session pooler (port 5432, IPv4-compatible) — used only for `prisma migrate`.
DIRECT_URL=

PORT=3000

# JWT signing secret for front-desk auth. Must be >=32 characters — the server
# refuses to start otherwise. Generate a real random value for .env, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Channex.io API credentials (staging: https://staging.channex.io, no card required).
# user-api-key header value, generated from the Organization page in Channex's dashboard.
CHANNEX_API_KEY=

CHANNEX_BASE_URL=

# Channex has no built-in webhook signing (per Phase 4 research) — this is a
# shared secret WE invent, set as a custom header on the webhook's Channex-side
# config, and check for on every incoming request.
CHANNEX_WEBHOOK_SECRET=

# Comma-separated allowlist of exact frontend origins allowed to call this API
# cross-origin (scheme+host+port, no wildcard, no trailing slash). The server
# refuses to start if this is missing/empty/malformed — an unconfigured origin
# allowlist is a silent security gap, not a runtime error to fail open on.
#   e.g. CORS_ORIGIN=https://your-staging-app.vercel.app
# Local dev doesn't need this set (Vite's dev proxy makes /api same-origin),
# but the server won't start without SOME value — use http://localhost:5173.
CORS_ORIGIN=

# Optional — error monitoring. Leave blank to run without it, e.g. local dev.
SENTRY_DSN=
